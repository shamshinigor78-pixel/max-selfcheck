/* ============================================
   СБРОС И БАЗОВЫЕ НАСТРОЙКИ
   ============================================ */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

html, body {
  overscroll-behavior: none;
  min-height: 100%;
}

/* ============================================
   ТЕМЫ
   ============================================ */
:root {
  --bg: #ffffff;
  --fg: #1a1a1a;
  --muted: #8a8a8e;
  --accent: #4a6cf7;
  --accent-soft: #eef1fe;
  --good: #22c55e;
  --warn: #f59e0b;
  --bad: #ef4444;
  --border: #ececec;
  --card-bg: #f8f8fa;
  --note-bg: #fff8e6;
  --note-border: #f0d89a;
  --note-fg: #6b4e00;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #15161a;
    --fg: #f0f0f2;
    --muted: #9a9aa0;
    --accent: #6b8afd;
    --accent-soft: #1e2540;
    --border: #2a2c33;
    --card-bg: #1e2026;
    --note-bg: #2a2410;
    --note-border: #5a4a1a;
    --note-fg: #f0d89a;
  }
}

/* ============================================
   БАЗА
   ============================================ */
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--fg);
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  justify-content: center;
  transition: background-color .2s ease, color .2s ease;
}

#app {
  width: 100%;
  max-width: 480px;
  padding: calc(env(safe-area-inset-top, 0px) + 1.5rem)
           calc(env(safe-area-inset-right, 0px) + 1.25rem)
           calc(env(safe-area-inset-bottom, 0px) + 2.5rem)
           calc(env(safe-area-inset-left, 0px) + 1.25rem);
}

.screen { display: none; }
.screen.active { display: block; }

/* ============================================
   СТАРТОВЫЙ ЭКРАН
   ============================================ */
.logo {
  font-size: 3.5rem;
  text-align: center;
  margin: 1.5rem 0 1rem;
  line-height: 1;
}

h1 {
  font-size: 1.625rem;
  line-height: 1.2;
  text-align: center;
  margin-bottom: .625rem;
  overflow-wrap: break-word;
  word-wrap: break-word;
}

.subtitle {
  text-align: center;
  color: var(--muted);
  font-size: .9375rem;
  line-height: 1.5;
  margin-bottom: 1.25rem;
  overflow-wrap: break-word;
}

.hint {
  text-align: center;
  color: var(--muted);
  font-size: .75rem;
  margin-top: 1.25rem;
  line-height: 1.5;
}

.privacy-note {
  background: var(--note-bg);
  border: 1px solid var(--note-border);
  border-radius: .75rem;
  padding: .875rem 1rem;
  margin-bottom: 1.25rem;
  font-size: .8125rem;
  line-height: 1.5;
  color: var(--note-fg);
}

.privacy-note strong { display: block; margin-bottom: .375rem; }
.privacy-note ul { list-style: none; padding: 0; }
.privacy-note li {
  padding-left: .875rem;
  position: relative;
  margin-bottom: .25rem;
  overflow-wrap: break-word;
}
.privacy-note li::before { content: "—"; position: absolute; left: 0; }

/* ============================================
   КНОПКИ
   ============================================ */
.btn {
  display: block;
  width: 100%;
  min-height: 2.75rem;
  padding: 1rem;
  border: none;
  border-radius: .875rem;
  font-size: 1rem;
  font-weight: 600;
  font-family: inherit;
  text-decoration: none;
  text-align: center;
  line-height: 1.2;
  cursor: pointer;
  transition: transform .1s ease, background-color .2s ease;
}

.btn:active { transform: scale(.97); }
.btn.primary { background: var(--accent); color: #fff; }
.btn.secondary {
  background: transparent;
  color: var(--muted);
  margin-top: .625rem;
}

.action-block .btn.secondary {
  margin-top: 0;
  border: 1.5px solid var(--border);
  color: var(--fg);
  background: var(--bg);
}
.action-block .btn.primary { margin-top: 0; }
.action-block .btn + .btn { margin-top: .5rem; }

/* ============================================
   ПРОГРЕСС
   ============================================ */
.progress {
  height: .375rem;
  background: var(--border);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: .5rem;
}

.progress-bar {
  height: 100%;
  width: 0%;
  background: var(--accent);
  border-radius: 999px;
  transition: width .3s ease;
}

.progress-text {
  font-size: .8125rem;
  color: var(--muted);
  margin-bottom: 1.5rem;
}

/* ============================================
   ЭКРАН ВОПРОСА
   ============================================ */
#q-text {
  font-size: 1.25rem;
  line-height: 1.4;
  text-align: left;
  margin-bottom: 1.5rem;
  overflow-wrap: break-word;
  word-wrap: break-word;
  hyphens: auto;
}

.answers { display: flex; flex-direction: column; gap: .625rem; }

.answer {
  display: block;
  width: 100%;
  min-height: 2.75rem;
  padding: 1rem;
  border: 1.5px solid var(--border);
  border-radius: .875rem;
  background: var(--bg);
  color: var(--fg);
  font-size: .9375rem;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
  transition: all .15s ease;
  overflow-wrap: break-word;
  word-wrap: break-word;
}

.answer:active { transform: scale(.98); }

.answer.selected {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

/* ============================================
   ЭКРАН РЕЗУЛЬТАТА
   ============================================ */
.result-icon {
  font-size: 3.5rem;
  text-align: center;
  margin: 1rem 0 .5rem;
  line-height: 1;
}

.verdict {
  text-align: center;
  font-size: 1rem;
  color: var(--muted);
  margin-bottom: 1.5rem;
  overflow-wrap: break-word;
}

.result-body {
  font-size: .9375rem;
  line-height: 1.55;
  margin-bottom: 1.25rem;
  overflow-wrap: break-word;
}

.result-actions { margin-bottom: 1rem; }

.action-block {
  background: var(--card-bg);
  border-radius: 1rem;
  padding: 1rem;
  margin-bottom: .75rem;
}

.action-block:last-child { margin-bottom: 0; }

.action-title {
  font-size: .9375rem;
  font-weight: 600;
  margin-bottom: .25rem;
  line-height: 1.3;
}

.action-hint {
  font-size: .8125rem;
  color: var(--muted);
  margin-bottom: .75rem;
  line-height: 1.4;
}

/* ============================================
   АДАПТАЦИЯ: УЗКИЕ ЭКРАНЫ
   ============================================ */
@media (max-width: 360px) {
  html { font-size: 15px; }
  h1 { font-size: 1.375rem; }
  .logo { font-size: 3rem; margin: 1rem 0 .75rem; }
  .result-icon { font-size: 3rem; }
  #q-text { font-size: 1.125rem; }
  .answer { padding: .875rem; font-size: .875rem; }
  .verdict { font-size: .9375rem; }
}

/* ============================================
   АДАПТАЦИЯ: ПЛАНШЕТЫ
   ============================================ */
@media (min-width: 768px) {
  #app {
    padding-top: calc(env(safe-area-inset-top, 0px) + 2.5rem);
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 3.75rem);
  }
  h1 { font-size: 1.875rem; }
  .subtitle { font-size: 1rem; }
  #q-text { font-size: 1.375rem; }
  .answer { font-size: 1rem; padding: 1.125rem; }
}

/* ============================================
   ЛАНДШАФТ
   ============================================ */
@media (max-height: 500px) and (orientation: landscape) {
  #app {
    padding-top: calc(env(safe-area-inset-top, 0px) + .75rem);
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
  }
  .logo { font-size: 2.5rem; margin: .5rem 0; }
  h1 { font-size: 1.25rem; margin-bottom: .375rem; }
  .result-icon { font-size: 2.5rem; margin: .5rem 0; }
  .subtitle { margin-bottom: .75rem; font-size: .875rem; }
  .privacy-note { padding: .625rem .75rem; font-size: .75rem; margin-bottom: .75rem; }
  .progress-text { margin-bottom: 1rem; }
  #q-text { font-size: 1.125rem; margin-bottom: 1rem; }
  .answers { gap: .5rem; }
  .answer { padding: .75rem; font-size: .875rem; }
  .verdict { margin-bottom: 1rem; }
  .action-block { padding: .875rem; margin-bottom: .5rem; }
}

/* ============================================
   ДОСТУПНОСТЬ
   ============================================ */
@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

.answer:focus-visible,
.btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
